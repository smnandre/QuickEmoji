        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "打开发布页面" } }
      }
    },
    "Open Accessibility Settings" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Bedienungshilfen öffnen" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Open Accessibility Settings" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Abrir ajustes de accesibilidad" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ouvrir les réglages d’accessibilité" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "打开辅助功能设置" } }
      }
    },
    "QuickEmoji needs access before it can detect shortcuts, find the caret, and insert characters." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "QuickEmoji benötigt Zugriff, um Kurzbefehle zu erkennen, die Einfügemarke zu finden und Zeichen einzufügen." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "QuickEmoji needs access before it can detect shortcuts, find the caret, and insert characters." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "QuickEmoji necesita acceso para detectar atajos, encontrar el cursor e insertar caracteres." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "QuickEmoji a besoin d’un accès pour détecter les raccourcis, trouver le curseur et insérer des caractères." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "QuickEmoji 需要访问权限才能检测快捷键、定位光标并插入字符。" } }
      }
    },
    "QuickEmoji %@ is available.\n\nUpdate with Homebrew:\n%@" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "QuickEmoji %@ ist verfügbar.\n\nMit Homebrew aktualisieren:\n%@" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "QuickEmoji %@ is available.\n\nUpdate with Homebrew:\n%@" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "QuickEmoji %@ está disponible.\n\nActualizar con Homebrew:\n%@" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "QuickEmoji %@ est disponible.\n\nMettre à jour avec Homebrew :\n%@" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "QuickEmoji %@ 已可用。\n\n使用 Homebrew 更新：\n%@" } }
      }
    },
    "No Homebrew update is available." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Kein Homebrew-Update verfügbar." } },
