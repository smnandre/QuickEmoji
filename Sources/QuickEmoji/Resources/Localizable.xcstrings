    "Open Release Page" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Release-Seite öffnen" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Open Release Page" } },
